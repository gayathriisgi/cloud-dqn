# Copy this file to `.env` (same directory as docker-compose.yml) to
# override any of these defaults. `.env` is read automatically by
# `docker compose`; nothing here is required to get a working stack -
# every value already has a sensible default in docker-compose.yml.

# Logging
LOG_LEVEL=INFO

# Backend workload simulator
MEMORY_CAP_MB=512

# Balancer -> backend request behaviour
REQUEST_TIMEOUT=5
METRICS_TIMEOUT=1.5

# ACO baseline
ACO_EVAPORATION_RATE=0.1

# DQN inference
# DQN_INFERENCE_EPSILON: 0.0 = pure exploitation (argmax Q), the
# spec-required default. Set >0 (e.g. 0.05) to keep a little
# exploration alive during a live demo.
DQN_INFERENCE_EPSILON=0.0
# DQN_ONLINE_LEARNING: off by default - the DQN balancer serves the
# frozen policy trained by `python dqn/train.py`. Set to "true" to let
# the running balancer keep learning from live traffic (it will
# periodically overwrite models/dqn_model.pt).
DQN_ONLINE_LEARNING=false
# DQN_TIE_MARGIN (v3): servers whose Q-value is within this margin of the
# best are treated as tied and one is picked at random (0 = strict argmax).
DQN_TIE_MARGIN=0.15
# DQN_TORCH_THREADS (v3): intra-op threads per inference (1 is best for a
# tiny MLP served by many concurrent Flask threads).
DQN_TORCH_THREADS=1

# TCE MyCamu (v3)
MYCAMU_DEFAULT_ALGORITHM=dqn

# traffic-generator service (only runs via `docker compose --profile tools run ...`)
TRAFFIC_PATTERN=normal
TRAFFIC_DURATION=60
TRAFFIC_RATE=10

# Grafana admin login (default admin/admin - change this if you expose
# Grafana beyond localhost)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

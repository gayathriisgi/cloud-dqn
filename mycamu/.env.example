# Copy to mycamu/.env for local (non-Docker) runs if you want to override.
# Inside Docker Compose these exact values are set in docker-compose.yml.
# Backends listen on port 5000 INSIDE the Docker network (5001-5004 are host mappings only).
ROUND_ROBIN_URL=http://round-robin:8000
LEAST_CONNECTIONS_URL=http://least-connections:8001
ACO_URL=http://aco-balancer:8002
DQN_URL=http://dqn-balancer:8003
SERVER1_URL=http://server1:5000
SERVER2_URL=http://server2:5000
SERVER3_URL=http://server3:5000
SERVER4_URL=http://server4:5000

# Local development (no Docker) - use the published host ports instead:
# ROUND_ROBIN_URL=http://localhost:8000
# LEAST_CONNECTIONS_URL=http://localhost:8001
# ACO_URL=http://localhost:8002
# DQN_URL=http://localhost:8003
# SERVER1_URL=http://localhost:5001
# SERVER2_URL=http://localhost:5002
# SERVER3_URL=http://localhost:5003
# SERVER4_URL=http://localhost:5004

# Optional
# MYCAMU_SECRET_KEY=change-me          (otherwise generated once and stored in the data volume)
# MYCAMU_DEFAULT_ALGORITHM=dqn
# MYCAMU_DEMO_PASSWORD=tce@123         (only used when seeding an EMPTY database)
